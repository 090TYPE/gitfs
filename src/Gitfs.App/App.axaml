<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Gitfs.App.App">

  <!-- Трей: приложение живёт в фоне, пока смонтирован хотя бы один том -->
  <TrayIcon.Icons>
    <TrayIcons>
      <!-- Иконка и меню собираются в коде: в них живёт состояние (бейдж с
           числом томов, подменю на каждый том), а разметка описать его не
           может. Здесь остаётся только исходная иконка на время запуска. -->
      <TrayIcon Icon="/Assets/gitfs.ico" ToolTipText="gitfs"
                Clicked="OnTrayClicked" />
    </TrayIcons>
  </TrayIcon.Icons>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Gitfs.App/Theme.axaml" />
        <ResourceInclude Source="avares://Gitfs.App/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!-- Акцент Fluent — это акцент СИСТЕМЫ: флажки, переключатели и
         выделенная строка списка красились синим по умолчанию Windows (и
         оранжевым у того, кто выбрал оранжевый). В одном окне уживались два
         «главных цвета», и наш был не главный.

         Переопределить его через <Color x:Key="SystemAccentColor"> в своём
         словаре НЕ выходит — проверено на живом окне, выделение осталось
         синим: тема разворачивает палитру у себя внутри, до наших ресурсов.
         Работает только эта точка. -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#9184d9" />
        <ColorPaletteResources x:Key="Light" Accent="#796cbf" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <!-- Палитра Nocturne из макета дизайн-отдела -->
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource GfsBgBrush}" />
      <Setter Property="FontFamily" Value="{DynamicResource GfsSans}" />
    </Style>

    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource GfsTextBrush}" />
    </Style>
    <Style Selector="TextBlock.kicker">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource GfsAccentBrush}" />
      <Setter Property="LetterSpacing" Value="1.4" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource GfsTextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="{DynamicResource GfsMono}" />
      <Setter Property="Foreground" Value="{DynamicResource GfsTextBrush}" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource GfsSurfaceBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource GfsAccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource GfsAccentBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,7" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource GfsAccentWashBrush}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource GfsAccentInkBrush}" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource GfsDividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource GfsTextBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,7" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource GfsSurfaceDeepBrush}" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource GfsSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource GfsDividerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource GfsTextBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontFamily" Value="{DynamicResource GfsMono}" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource GfsTextBrush}" />
    </Style>
  </Application.Styles>
</Application>
