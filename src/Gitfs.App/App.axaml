<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Gitfs.App.App"
             RequestedThemeVariant="Dark">

  <!-- Трей: приложение живёт в фоне, пока смонтирован хотя бы один том -->
  <TrayIcon.Icons>
    <TrayIcons>
      <!-- Иконка и меню собираются в коде: в них живёт состояние (бейдж с
           числом томов, подменю на каждый том), а разметка описать его не
           может. Здесь остаётся только исходная иконка на время запуска. -->
      <TrayIcon Icon="/Assets/gitfs.ico" ToolTipText="gitfs"
                Clicked="OnTrayClicked" />
    </TrayIcons>
  </TrayIcon.Icons>

  <Application.Styles>
    <FluentTheme />

    <!-- Палитра Nocturne из макета дизайн-отдела -->
    <Style Selector="Window">
      <Setter Property="Background" Value="#161826" />
      <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif" />
    </Style>

    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="#e9e9ed" />
    </Style>
    <Style Selector="TextBlock.kicker">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="#9184d9" />
      <Setter Property="LetterSpacing" Value="1.4" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#9397ab" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
      <Setter Property="Foreground" Value="#cfd3e5" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="#232532" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#9184d9" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#9184d9" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,7" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2b2741" />
      <Setter Property="TextElement.Foreground" Value="#b5abfc" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#3f424d" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#cfd3e5" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,7" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2b2d3a" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="#232532" />
      <Setter Property="BorderBrush" Value="#3f424d" />
      <Setter Property="Foreground" Value="#e9e9ed" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#cfd3e5" />
    </Style>
  </Application.Styles>
</Application>
