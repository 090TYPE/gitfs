<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:Gitfs.App"
        x:Class="Gitfs.App.MountDialog"
        Title="Mount repository" Width="820" Height="660" MinHeight="420"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="*,300">

      <!-- Слева выбор, и он ОБЯЗАН прокручиваться: раскрытый Advanced не
           влезал в окно, и секция открывалась в полоску высотой в пиксель —
           настройки существовали и были недоступны. -->
      <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20" Spacing="16">

        <StackPanel Spacing="6">
          <TextBlock Text="Repository" Classes="muted" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" x:Name="RepoBox" Watermark="path to a git repository"
                     TextChanged="OnRepoChanged" />
            <Button Grid.Column="1" Classes="secondary" Content="Browse…"
                    Margin="8,0,0,0" Click="OnBrowse" />
          </Grid>
          <!-- Недавние: один клик вместо повторного набора пути (макет 03) -->
          <WrapPanel x:Name="RecentChips" Orientation="Horizontal" />
          <TextBlock x:Name="RepoProblem" Classes="muted" Foreground="{DynamicResource GfsErrBrush}"
                     IsVisible="False" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Mount point" Classes="muted" />
          <!-- Буква или папка — это ВЫБОР, а не следствие платформы. На
               Windows том умеет встать и в пустой каталог; молча решать за
               человека значит прятать половину возможностей. -->
          <StackPanel x:Name="MountKindBox" Orientation="Horizontal" Spacing="14">
            <RadioButton x:Name="KindLetter" GroupName="mountkind" Content="Drive letter"
                         IsChecked="True" IsCheckedChanged="OnMountKindChanged" />
            <RadioButton x:Name="KindFolder" GroupName="mountkind" Content="Folder"
                         IsCheckedChanged="OnMountKindChanged" />
          </StackPanel>
          <Grid ColumnDefinitions="Auto,*">
            <ComboBox Grid.Column="0" x:Name="LetterBox" Width="90"
                      SelectionChanged="OnLetterChanged" />
            <TextBox Grid.Column="0" x:Name="FolderBox" Width="240" IsVisible="False"
                     Watermark="folder to mount into" TextChanged="OnFolderChanged" />
            <TextBlock Grid.Column="1" x:Name="LettersHint" Classes="muted"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       TextWrapping="Wrap" />
          </Grid>
          <TextBlock x:Name="FolderNote" Classes="muted" IsVisible="False"
                     TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Views" Classes="muted" />
          <Border Background="{DynamicResource GfsSurfaceBrush}" CornerRadius="8" Padding="12">
            <StackPanel Spacing="8">
              <CheckBox x:Name="ViewBranches" IsChecked="True" IsCheckedChanged="OnViewToggled">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <app:Glyph Key="IcViewBranches" Width="16" Height="16" Thickness="2.0"
                             VerticalAlignment="Center" Stroke="{DynamicResource GfsTextMutedBrush}" />
                  <TextBlock Text="branches" Classes="mono" Width="72" />
                  <TextBlock Text="every branch as a live working tree" Classes="muted" />
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="ViewTags" IsChecked="True" IsCheckedChanged="OnViewToggled">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <app:Glyph Key="IcViewTags" Width="16" Height="16" Thickness="2.0"
                             VerticalAlignment="Center" Stroke="{DynamicResource GfsTextMutedBrush}" />
                  <TextBlock Text="tags" Classes="mono" Width="72" />
                  <TextBlock Text="released versions, frozen" Classes="muted" />
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="ViewCommits" IsChecked="True" IsCheckedChanged="OnViewToggled">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <app:Glyph Key="IcViewCommits" Width="16" Height="16" Thickness="2.0"
                             VerticalAlignment="Center" Stroke="{DynamicResource GfsTextMutedBrush}" />
                  <TextBlock Text="commits" Classes="mono" Width="72" />
                  <TextBlock Text="the last 200 commits by sha" Classes="muted" />
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="ViewDates" IsCheckedChanged="OnViewToggled">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <app:Glyph Key="IcViewDates" Width="16" Height="16" Thickness="2.0"
                             VerticalAlignment="Center" Stroke="{DynamicResource GfsTextMutedBrush}" />
                  <TextBlock Text="dates" Classes="mono" Width="72" />
                  <TextBlock Text="the same commits, filed by day" Classes="muted" />
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="ViewHistory" IsChecked="True" IsCheckedChanged="OnViewToggled">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <app:Glyph Key="IcViewHistory" Width="16" Height="16" Thickness="2.0"
                             VerticalAlignment="Center" Stroke="{DynamicResource GfsAccentInkBrush}" />
                  <TextBlock Text="history" Classes="mono" Width="72" Foreground="{DynamicResource GfsAccentInkBrush}" />
                  <TextBlock Text="each file opens as a folder of its versions"
                             Classes="muted" Foreground="{DynamicResource GfsAccentInkBrush}" />
                </StackPanel>
              </CheckBox>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Advanced: всё здесь действует. Переключатель, который ничего не
             меняет, хуже отсутствующего — пользователь считает, что настроил. -->
        <Expander x:Name="AdvancedBox" IsExpanded="False" Expanded="OnAdvancedExpanded">
          <Expander.Header>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="Advanced" />
              <!-- Сводка рядом с заголовком: свёрнутая секция обязана
                   признаваться, что в ней что-то изменено (макет 03). -->
              <TextBlock x:Name="AdvancedSummary" Classes="muted"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Expander.Header>
          <StackPanel Spacing="10" Margin="0,8,0,0">
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" >
              <TextBlock Grid.Row="0" Grid.Column="0" Text="History ref" Classes="muted"
                         VerticalAlignment="Center" />
              <TextBox Grid.Row="0" Grid.Column="1" x:Name="HistoryRefBox" Margin="0,0,0,6"
                       Watermark="HEAD" TextChanged="OnAdvancedChanged" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Commit limit" Classes="muted"
                         VerticalAlignment="Center" />
              <TextBox Grid.Row="1" Grid.Column="1" x:Name="CommitLimitBox" Margin="0,0,0,6"
                       Text="200" TextChanged="OnAdvancedChanged" />

              <TextBlock Grid.Row="2" Grid.Column="0" Text="History limit" Classes="muted"
                         VerticalAlignment="Center" />
              <TextBox Grid.Row="2" Grid.Column="1" x:Name="HistoryLimitBox" Margin="0,0,0,6"
                       Text="500" TextChanged="OnAdvancedChanged" />

              <TextBlock Grid.Row="3" Grid.Column="0" Text="Cache, MB" Classes="muted"
                         VerticalAlignment="Center" />
              <TextBox Grid.Row="3" Grid.Column="1" x:Name="CacheBox" Margin="0,0,0,6"
                       Text="256" TextChanged="OnAdvancedChanged" />

              <TextBlock Grid.Row="4" Grid.Column="0" Text="Max cached blob, MB" Classes="muted"
                         VerticalAlignment="Center" />
              <TextBox Grid.Row="4" Grid.Column="1" x:Name="MaxBlobBox" Margin="0,0,0,6"
                       Text="8" TextChanged="OnAdvancedChanged" />

              <TextBlock Grid.Row="5" Grid.Column="0" Text="Name policy" Classes="muted"
                         VerticalAlignment="Center" />
              <ComboBox Grid.Row="5" Grid.Column="1" x:Name="PolicyBox" Width="160"
                        HorizontalAlignment="Left" SelectionChanged="OnAdvancedChanged" />
            </Grid>

            <!-- Включено по умолчанию — так в макете (index.html:246), и на то
                 есть причина сильнее вкуса: запись на этот том НЕ доходит до
                 репозитория, она уходит в песочницу, которая исчезнет вместе с
                 томом. Человек, правящий файл в G:\branches\main\ и уверенный,
                 что правит свой репозиторий, теряет работу молча. Снять галку —
                 осознанное действие, и подпись говорит, когда это нужно. -->
            <CheckBox x:Name="ReadOnlyBox" IsChecked="True" IsCheckedChanged="OnAdvancedChanged">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Read-only volume" Width="150" />
                <TextBlock Classes="muted" Text="uncheck for Word and Excel: they write lock files next to an opened file" />
              </StackPanel>
            </CheckBox>
            <!-- А ВОТ ЗДЕСЬ МЫ ОТ МАКЕТА ОТСТУПАЕМ, и намеренно. В макете
                 (index.html:249) галка стоит, но оставленная песочница — это
                 ровно то, что бриф §4.2 велит показывать как деградацию:
                 «осиротевший overlay — warning». Включив её по умолчанию, мы бы
                 получили продукт, который сразу после первого размонтирования
                 жалуется сам на себя. Умолчание — убирать за собой. -->
            <CheckBox x:Name="KeepOverlayBox" IsCheckedChanged="OnAdvancedChanged">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Keep overlay after unmount" Width="150" />
                <TextBlock Classes="muted" Text="to inspect what was written; gitfs purge removes it later" />
              </StackPanel>
            </CheckBox>

            <TextBlock x:Name="AdvancedProblem" Classes="muted" Foreground="{DynamicResource GfsErrBrush}"
                       IsVisible="False" TextWrapping="Wrap" />
          </StackPanel>
        </Expander>
      </StackPanel>
      </ScrollViewer>

      <!-- справа: живое превью дерева -->
      <Border Grid.Column="1" Background="{DynamicResource GfsSurfaceDeepBrush}" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Classes="kicker" Text="YOU WILL GET" />
          <StackPanel x:Name="TreePreview" Spacing="3" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,8,0,0"
                     Text="Unchecked views are struck through rather than hidden, so the choice stays visually reversible." />
        </StackPanel>
      </Border>
    </Grid>

    <!-- футер -->
    <Border Grid.Row="1" Background="{DynamicResource GfsFooterBrush}" Padding="16,12">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0" x:Name="FooterFlags" Classes="muted"
                   VerticalAlignment="Center" Text="read-only" />
        <Button Grid.Column="1" Classes="secondary" Content="Cancel"
                Margin="0,0,8,0" Click="OnCancel" />
        <Button Grid.Column="2" x:Name="MountAction" Classes="primary"
                Content="Mount" Click="OnMount" />
      </Grid>
    </Border>
  </Grid>
</Window>
