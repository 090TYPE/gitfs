<Project>

  <!--
    Какой адаптер файловой системы попадает в сборку.

    Ориентир — ЦЕЛЕВАЯ платформа (RuntimeIdentifier), а не машина, на которой
    идёт сборка. Условие по хосту выглядит так же и работает так же ровно до
    первой кросс-публикации: `dotnet publish -r linux-x64` с Windows собрал бы
    Linux-бинарник с адаптером WinFsp внутри и без FUSE.

    Без RuntimeIdentifier (обычный dotnet build, тесты) берём хост — там
    целевая платформа и есть текущая.
  -->
  <PropertyGroup>
    <GitfsTargetWindows Condition="$(RuntimeIdentifier.StartsWith('win'))">true</GitfsTargetWindows>
    <!--
      Только x64. Смещения полей в FuseAbi сняты на linux-x86_64 и на другой
      архитектуре неверны: на aarch64 struct stat весит 128 байт вместо 144,
      а st_mode лежит на 16 вместо 24. Ни сборка, ни тесты этого не заметят —
      publish под linux-arm64 проходит, фикстура сверяется сама с собой, CI
      гоняет только x86_64. Пусть лучше адаптер не попадёт в сборку.
    -->
    <GitfsTargetLinux Condition="$(RuntimeIdentifier.StartsWith('linux')) and $(RuntimeIdentifier.Contains('-x64'))">true</GitfsTargetLinux>

    <GitfsTargetWindows Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">true</GitfsTargetWindows>
    <GitfsTargetLinux Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">true</GitfsTargetLinux>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GitfsTargetWindows)' == 'true'">
    <DefineConstants>$(DefineConstants);GITFS_WINFSP</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GitfsTargetLinux)' == 'true'">
    <DefineConstants>$(DefineConstants);GITFS_FUSE</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(GitfsTargetWindows)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)Gitfs.Mount.WinFsp\Gitfs.Mount.WinFsp.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(GitfsTargetLinux)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)Gitfs.Mount.Fuse\Gitfs.Mount.Fuse.csproj" />
  </ItemGroup>

</Project>
