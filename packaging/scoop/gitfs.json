{
    "version": "0.1.0",
    "description": "Mounts a git repository as a drive. Commits are folders; a file is a folder too, holding every version of itself.",
    "homepage": "https://github.com/090TYPE/gitfs",
    "license": "MIT",
    "notes": [
        "gitfs needs the WinFsp driver to create a volume: https://winfsp.dev/rel/",
        "Run 'gitfs doctor' first — it names anything missing before you try to mount.",
        "'gitfs tree' works without any driver at all."
    ],
    "suggest": {
        "WinFsp": "winfsp"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/090TYPE/gitfs/releases/download/v0.1.0/gitfs-win-x64.exe#/gitfs.exe",
            "hash": "9398bb8dc390368a616b9ac4e4db5b5aeadf345f21619f02e8d408e41c5ccaf5"
        }
    },
    "bin": "gitfs.exe",
    "checkver": {
        "github": "https://github.com/090TYPE/gitfs"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/090TYPE/gitfs/releases/download/v$version/gitfs-win-x64.exe#/gitfs.exe"
            }
        },
        "hash": {
            "url": "https://github.com/090TYPE/gitfs/releases/download/v$version/SHA256SUMS.txt",
            "regex": "$sha256\\s+gitfs-win-x64\\.exe"
        }
    }
}
